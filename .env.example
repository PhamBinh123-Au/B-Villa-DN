# =======================================================================
# B VILLA ĐÀ NẴNG - MẪU BIẾN MÔI TRƯỜNG (.env.example)
# =======================================================================
# SAO CHÉP FILE NÀY THÀNH .env.local ĐỂ SỬ DỤNG TRÊN MÔI TRƯỜNG LOCAL
# HOẶC THIẾT LẬP TRÊN VERCEL / CLOUDFLARE ENVIRONMENT VARIABLES
# TUYỆT ĐỐI KHÔNG COMMIT FILE .env / .env.local LÊN GIT!
# =======================================================================

# Môi trường chạy (development | production)
NODE_ENV=production

# URL tên miền chính thức của website (dùng để chặn CORS & cấu hình bảo mật)
NEXT_PUBLIC_SITE_URL=https://bvilladanang.com

# Khóa bí mật dùng để ký và xác thực session token admin (Bắt buộc đổi sang chuỗi ngẫu nhiên dài trên Production)
ADMIN_SESSION_SECRET=bvilla_super_secret_jwt_key_change_in_production_2026_random_string_here

# Mã PIN đăng nhập Quản Trị Viên (Ưu tiên đọc từ biến môi trường để không lộ trong mã nguồn)
ADMIN_PIN=200928
MANAGER_PIN=000000

# Tùy chọn lưu trữ đám mây (Cloud Storage) khi deploy serverless (Vercel / Netlify / Render)
# Nếu không cung cấp, hệ thống sẽ tự động lưu vào file data/bookings-db.json trên server local
# UPSTASH REDIS / VERCEL KV:
# KV_REST_API_URL=https://xxxx.upstash.io
# KV_REST_API_TOKEN=xxxx

