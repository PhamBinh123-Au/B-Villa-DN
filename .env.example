# =======================================================================
# B VILLA ĐÀ NẴNG - MẪU BIẾN MÔI TRƯỜNG (.env.example)
# =======================================================================
# SAO CHÉP FILE NÀY THÀNH .env.local ĐỂ SỬ DỤNG TRÊN MÔI TRƯỜNG LOCAL
# TUYỆT ĐỐI KHÔNG COMMIT FILE .env.local LÊN GIT!
# =======================================================================

# Môi trường chạy (development | production)
NODE_ENV=development

# URL tên miền chính thức của website (dùng để chặn CORS & cấu hình bảo mật)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret Key dùng để ký session token admin
ADMIN_SESSION_SECRET=bvilla_super_secret_jwt_key_change_in_production_2026

# Mã PIN quản trị mặc định (Tùy chọn: có thể cấu hình qua src/config/adminPinConfig.ts hoặc ghi đè bằng env)
DEFAULT_ADMIN_PIN=123456
DEFAULT_MANAGER_PIN=654321
